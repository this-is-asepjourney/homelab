          "datasource": {
            "type": "postgres",
            "uid": "postgres-iot-db"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(SUM(CASE WHEN status = 'COMPLETED' THEN COALESCE(duration_sec, 0) ELSE GREATEST(COALESCE(duration_sec, 0), GREATEST(0, EXTRACT(EPOCH FROM (NOW() - check_in_at))::int)) END), 0) AS v FROM work_attendance_sessions WHERE device_serial = '$serial' AND $__timeFilter(check_in_at)",
          "refId": "A"
        }
