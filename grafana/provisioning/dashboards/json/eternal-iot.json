    {
      "id": 16,
      "type": "table",
      "title": "Rekap Jam Kerja per Pekerja",
      "description": "Ringkasan total sesi & akumulasi jam kerja per pekerja.",
      "datasource": {
        "type": "postgres",
        "uid": "postgres-iot-db"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres-iot-db"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH periode AS (  SELECT UPPER(uid) AS uid_key, COUNT(*) AS p_sess, COALESCE(SUM(CASE WHEN status = 'COMPLETED' THEN COALESCE(duration_sec, 0) ELSE GREATEST(COALESCE(duration_sec, 0), GREATEST(0, EXTRACT(EPOCH FROM (NOW() - check_in_at))::int)) END), 0)::bigint AS p_sec   FROM work_attendance_sessions WHERE device_serial = '$serial' AND $__timeFilter(check_in_at)   GROUP BY UPPER(uid)), totals AS (  SELECT UPPER(uid) AS uid_key, COUNT(*) AS a_sess, COALESCE(SUM(CASE WHEN status = 'COMPLETED' THEN COALESCE(duration_sec, 0) ELSE GREATEST(COALESCE(duration_sec, 0), GREATEST(0, EXTRACT(EPOCH FROM (NOW() - check_in_at))::int)) END), 0)::bigint AS a_sec   FROM work_attendance_sessions WHERE device_serial = '$serial'   GROUP BY UPPER(uid)) SELECT u.nama AS \"Nama\", u.role AS \"Role\", COALESCE(p.p_sess, 0) AS \"Sesi (Periode)\", LPAD(((COALESCE(p.p_sec, 0)) / 3600)::text, 2, '0') || ':' || LPAD((((COALESCE(p.p_sec, 0)) % 3600) / 60)::text, 2, '0') || ':' || LPAD(((COALESCE(p.p_sec, 0)) % 60)::text, 2, '0') AS \"Durasi (Periode)\", GREATEST(COALESCE(u.total_sessions, 0), COALESCE(t.a_sess, 0)) AS \"Total Sesi\", LPAD(((GREATEST(COALESCE(u.total_work_sec, 0), COALESCE(t.a_sec, 0))) / 3600)::text, 2, '0') || ':' || LPAD((((GREATEST(COALESCE(u.total_work_sec, 0), COALESCE(t.a_sec, 0))) % 3600) / 60)::text, 2, '0') || ':' || LPAD(((GREATEST(COALESCE(u.total_work_sec, 0), COALESCE(t.a_sec, 0))) % 60)::text, 2, '0') AS \"Total Jam Kerja\", COALESCE(TO_CHAR(u.last_login_at AT TIME ZONE 'Asia/Jakarta', 'YYYY-MM-DD HH24:MI'), '–') AS \"Terakhir Absen\" FROM nfc_users u LEFT JOIN periode p ON UPPER(u.uid) = p.uid_key LEFT JOIN totals t ON UPPER(u.uid) = t.uid_key WHERE u.is_active = 1 ORDER BY COALESCE(p.p_sec, 0) DESC, GREATEST(COALESCE(u.total_work_sec, 0), COALESCE(t.a_sec, 0)) DESC, u.id ASC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "cellOptions": {
              "type": "auto"
            }
          },
          "noValue": "Belum ada data"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 17,
      "type": "table",
      "title": "Rekap Sesi Absensi Kerja",
      "description": "Detail sesi check-in dan check-out pekerja dari ESP32.",
