    {
      "id": 15,
      "type": "timeseries",
      "title": "Aktivitas Absensi per Jam",
      "description": "Distribusi tap Check-In, Check-Out, dan Ditolak per jam.",
      "datasource": {
        "type": "postgres",
        "uid": "postgres-iot-db"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres-iot-db"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(created_at,'1h'), SUM(CASE WHEN action_type NOT ILIKE '%DENIED%' AND (action_type ILIKE '%CHECK_IN%' OR action_type ILIKE '%CHECKIN%' OR action_type ILIKE '%UNLOCK%' OR action_type ILIKE '%TAP_ON%') THEN 1 ELSE 0 END) AS \"Check-In\", SUM(CASE WHEN action_type NOT ILIKE '%DENIED%' AND NOT (action_type ILIKE '%CHECK_IN%' OR action_type ILIKE '%CHECKIN%' OR action_type ILIKE '%UNLOCK%' OR action_type ILIKE '%TAP_ON%') THEN 1 ELSE 0 END) AS \"Check-Out\", SUM(CASE WHEN action_type ILIKE '%DENIED%' THEN 1 ELSE 0 END) AS \"Ditolak\" FROM nfc_access_logs WHERE device_serial = '$serial' AND $__timeFilter(created_at) GROUP BY 1 ORDER BY 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "Belum ada data",
          "custom": {
            "drawStyle": "bars",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 75,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
