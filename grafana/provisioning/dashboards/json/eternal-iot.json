    {
      "id": 5,
      "type": "stat",
      "title": "Durasi Kerja Berjalan",
      "description": "Stopwatch durasi sesi kerja yang sedang berlangsung.",
      "datasource": {
        "type": "postgres",
        "uid": "postgres-iot-db"
      },
      "gridPos": {
