          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(NULLIF(nama,'-'), 'Pengguna NFC') AS \"Nama\", role AS \"Role\", status AS \"Status\", COALESCE(check_in_wib, TO_CHAR(check_in_at AT TIME ZONE 'Asia/Jakarta', 'YYYY-MM-DD HH24:MI:SS')) AS \"Masuk\", COALESCE(check_out_wib, TO_CHAR(check_out_at AT TIME ZONE 'Asia/Jakarta', 'YYYY-MM-DD HH24:MI:SS'), '–') AS \"Pulang\", CASE WHEN status = 'WORKING' THEN LPAD(((GREATEST(0, EXTRACT(EPOCH FROM (NOW() - check_in_at))::int)) / 3600)::text, 2, '0') || ':' || LPAD((((GREATEST(0, EXTRACT(EPOCH FROM (NOW() - check_in_at))::int)) % 3600) / 60)::text, 2, '0') || ':' || LPAD(((GREATEST(0, EXTRACT(EPOCH FROM (NOW() - check_in_at))::int)) % 60)::text, 2, '0') ELSE COALESCE(NULLIF(duration_hms, '00:00:00'), LPAD(((COALESCE(duration_sec, 0)) / 3600)::text, 2, '0') || ':' || LPAD((((COALESCE(duration_sec, 0)) % 3600) / 60)::text, 2, '0') || ':' || LPAD(((COALESCE(duration_sec, 0)) % 60)::text, 2, '0')) END AS \"Durasi\", ROUND(suhu_in::numeric, 1) AS \"Suhu Masuk (°C)\", ROUND(suhu_out::numeric, 1) AS \"Suhu Pulang (°C)\" FROM work_attendance_sessions WHERE device_serial = '$serial' AND $__timeFilter(check_in_at) ORDER BY check_in_at DESC, id DESC LIMIT 50",
          "refId": "A"
        }
