          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE WHEN is_locked = 0 THEN GREATEST(COALESCE(work_elapsed_sec, 0), COALESCE(EXTRACT(EPOCH FROM (NOW() - unlocked_at))::int, 0)) ELSE 0 END AS v FROM device_locks WHERE device_serial = '$serial' LIMIT 1",
