    {
      "id": 12,
      "type": "stat",
      "title": "Total Jam Kerja",
      "description": "Akumulasi total durasi kerja seluruh pekerja pada rentang waktu terpilih.",
      "datasource": {
        "type": "postgres",
        "uid": "postgres-iot-db"
