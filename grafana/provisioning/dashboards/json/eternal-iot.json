    {
      "id": 2,
      "type": "stat",
      "title": "Perangkat",
      "description": "Online bila ada paket MQTT dari ESP32 dalam 90 detik terakhir.",
      "datasource": {
        "type": "postgres",
        "uid": "postgres-iot-db"
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres-iot-db"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE WHEN last_seen_at >= NOW() - INTERVAL '90 seconds' THEN 1 ELSE 0 END AS v FROM iot_devices WHERE device_serial = '$serial' LIMIT 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
