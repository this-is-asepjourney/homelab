          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(recorded_at,'1m'), AVG(temperature_c) AS \"Suhu\", AVG(heat_index_c) AS \"Heat Index\" FROM iot_telemetry_logs WHERE $__timeFilter(recorded_at) AND device_serial = '$serial' AND temperature_c > 0 GROUP BY 1 ORDER BY 1",
