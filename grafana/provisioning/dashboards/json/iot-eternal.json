    {
      "id": 1,
      "title": "Device Status",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 0, "y": 1 },
      "datasource": {
        "type": "postgres",
        "uid": "postgres-iot-db"
      },
      "pluginVersion": "10.0.0",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "ONLINE": { "color": "green", "index": 0, "text": "ONLINE" },
                "OFFLINE": { "color": "red", "index": 1, "text": "OFFLINE" }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres-iot-db"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE WHEN last_seen_at >= NOW() - INTERVAL '90 seconds' THEN 'ONLINE' ELSE 'OFFLINE' END AS \"Connection\" FROM iot_devices WHERE ('$device' = 'All' OR device_serial = '$device') ORDER BY last_seen_at DESC LIMIT 1;",
          "refId": "A"
        }
      ]
    },
